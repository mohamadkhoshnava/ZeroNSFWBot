# =============================================================================
# ZeroNSFWBot — copy to `.env` and fill in.  NEVER commit the real `.env`.
# =============================================================================

# ---- Telegram ------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Without the leading @. Used to build the "Add to group" deep link.
BOT_USERNAME=ZeroNSFWBot
# Display name used inside messages.
BOT_NAME=Zero NSFW Guard

# Public source repository, linked from the bot's private chat.
PROJECT_URL=https://github.com/mohamadkhoshnava/ZeroNSFWBot

# Comma-separated NUMERIC user ids with full bot-wide power
# (/info, /broadcast). Get yours from @userinfobot.
SUPER_ADMINS=123456789

# IMPORTANT: disable Group Privacy in @BotFather
# (/mybots -> Bot Settings -> Group Privacy -> Turn off)
# otherwise the bot only sees commands, not the comments it must scan.

# ---- Postgres ------------------------------------------------------------
POSTGRES_USER=zeronsfw
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=zeronsfw
POSTGRES_PORT=5432
# Inside docker-compose the host is the service name `postgres`.
DATABASE_URL=postgres://zeronsfw:change_me_please@postgres:5432/zeronsfw
# For running the bot outside docker against the compose DB, use:
# DATABASE_URL=postgres://zeronsfw:change_me_please@localhost:5432/zeronsfw
DATABASE_MAX_CONNECTIONS=10

# ---- NSFW detector service ----------------------------------------------
DETECTOR_URL=http://detector:8000
DETECTOR_TIMEOUT_SECS=20
# Host port the detector is published on (for curl / eval scripts).
DETECTOR_PORT=8000
# Threads onnxruntime may use per inference.
DETECTOR_THREADS=2
# Model id resolved at image build time.
DETECTOR_MODEL_ID=Marqo/nsfw-image-detection-384
# Enable OCR of profile pictures (adds tesseract to the image, ~100MB).
ENABLE_OCR=true
OCR_LANGS=eng+fas+ara+rus

# ---- Moderation defaults (per-group values override these) ---------------
# Default UI language when the group's language cannot be detected.
DEFAULT_LANG=en
# Auto-ban threshold in percent (0-100).
DEFAULT_THRESHOLD=40
# Default policy preset: nsfw_only | nsfw_and_contact | nsfw_or_keywords | strict
DEFAULT_POLICY=nsfw_and_contact
# Default action: ban | delete | mute | report
DEFAULT_ACTION=ban
# How many of the newest profile photos to scan (index 0 is the pinned /
# currently displayed one). 2 covers "current + previous".
PROFILE_PHOTOS_TO_SCAN=2
# New groups start in dry-run (detect & report, never punish). Strongly
# recommended for the first week of any group.
DEFAULT_DRY_RUN=false
# Only scan members who joined recently or whose message count is below this.
# 0 disables the grace window and scans everyone.
DEFAULT_GRACE_MESSAGES=5
# Bot's own group messages are KEPT by default (they advertise the bot).
DEFAULT_AUTO_DELETE_BOT_MESSAGES=false
DEFAULT_BOT_MESSAGE_TTL_SECS=60
# Number of independent groups that must ban a user before the global
# reputation filter flags them elsewhere.
GLOBAL_REPUTATION_MIN_BANS=3

# ---- Caching / limits ----------------------------------------------------
SCAN_CACHE_TTL_SECS=86400
ADMIN_CACHE_TTL_SECS=300
# Private-chat NSFW test: max images per user per minute.
TEST_MODE_RATE_PER_MIN=10
# Broadcast send rate (messages/second). Telegram tolerates ~30/s bot-wide.
BROADCAST_RATE_PER_SEC=25

# ---- Logging -------------------------------------------------------------
RUST_LOG=info,zeronsfw_bot=debug,teloxide=warn,sqlx=warn
