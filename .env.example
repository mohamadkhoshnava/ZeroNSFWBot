# =============================================================================
# ZeroNSFWBot — copy to `.env` and fill in.  NEVER commit the real `.env`.
# =============================================================================

# ---- Telegram ------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Without the leading @. Used to build the "Add to group" deep link.
BOT_USERNAME=ZeroNSFWBot
# Display name used inside messages.
BOT_NAME=Zero NSFW Guard

# Public source repository, linked from the bot's private chat.
PROJECT_URL=https://github.com/mohamadkhoshnava/ZeroNSFWBot
# Credited at the foot of the bot's own messages. Leave empty for no credit.
DEVELOPER_CHANNEL=@SEYED_BAX

# Comma-separated NUMERIC user ids with full bot-wide power
# (/info, /broadcast). Get yours from @userinfobot.
SUPER_ADMINS=123456789

# IMPORTANT: disable Group Privacy in @BotFather
# (/mybots -> Bot Settings -> Group Privacy -> Turn off)
# otherwise the bot only sees commands, not the comments it must scan.

# ---- Postgres ------------------------------------------------------------
POSTGRES_USER=zeronsfw
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=zeronsfw
POSTGRES_PORT=5432
# Inside docker-compose the host is the service name `postgres`.
DATABASE_URL=postgres://zeronsfw:change_me_please@postgres:5432/zeronsfw
# For running the bot outside docker against the compose DB, use:
# DATABASE_URL=postgres://zeronsfw:change_me_please@localhost:5432/zeronsfw
DATABASE_MAX_CONNECTIONS=10

# ---- NSFW detector service ----------------------------------------------
DETECTOR_URL=http://detector:8000
DETECTOR_TIMEOUT_SECS=20
# Host port the detector is published on (for curl / eval scripts).
DETECTOR_PORT=8000
# Threads onnxruntime may use per inference.
DETECTOR_THREADS=2
# Model id resolved at image build time.
DETECTOR_MODEL_ID=Marqo/nsfw-image-detection-384
# The second-stage verifier. Only images the fast model flags are re-scored by
# it, so the extra cost lands on a small fraction of scans. Its value is the
# taxonomy: `drawings` and `sexy` are separate classes from `hentai` and `porn`,
# so an ordinary anime avatar stops being a ban.
VERIFIER_MODEL_ID=giacomoarienti/nsfw-classifier
# Turning this off makes the bot act on the fast model alone — which over-flags
# stylised art. Leave it on unless you are debugging.
ENABLE_VERIFIER=true
# Enable OCR of profile pictures (adds tesseract to the image, ~100MB).
ENABLE_OCR=true
OCR_LANGS=eng+fas+ara+rus
# Frame sampling for GIFs and videos (adds ffmpeg to the image, ~150MB).
# Telegram re-encodes every uploaded GIF to MP4, so without this the media scan
# falls back to the poster thumbnail — one arbitrary frame of the clip.
ENABLE_VIDEO=true
# Hard ceiling on frames sampled per clip, whatever a group asks for. Each
# frame is a full inference, so this bounds what one forwarded video costs.
DETECTOR_MAX_FRAMES=12
# Largest clip the bot will download to sample. Bigger ones fall back to the
# thumbnail. 20 MB is also the most Telegram's getFile will serve.
MEDIA_MAX_DOWNLOAD_BYTES=20971520

# ---- Jev (TypeSafe System One) -------------------------------------------
# Optional, and everything below degrades cleanly without it. Jev returns typed,
# calibrated decisions about TEXT — it takes no images, so every NSFW image
# score still comes from the local detector above and nothing about that
# changes. What it powers:
#   * the `bio_semantic` filter — reads a profile's text as advertising or not,
#     catching the obfuscated spellings and new slang a fixed word list cannot
#   * /nsfw -> Text scan — how strongly a message is about a chosen subject
#   * /nsfw -> Ad guard — whether a message is an advertisement
#   * the group language guess when the bot is first added
# With no key set, all four report themselves unavailable and the bot behaves
# exactly as it did before. An outage is never read as "this text is clean".
#
# PRIVACY: this sends profile text and, if you enable the text scan, message
# text to a third-party API in the US. Leave JEV_API_KEY unset to keep every
# scan on your own hardware.
#
# Pricing at the time of writing: $0.042 per million input tokens, output free.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
# Short by design: Jev answers in 70-500ms and this call sits in the path of an
# ordinary group message, so a slow answer is worth less than getting out of
# the way.
JEV_TIMEOUT_SECS=5

# ---- Moderation defaults (per-group values override these) ---------------
# Default UI language when the group's language cannot be detected.
DEFAULT_LANG=en
# Auto-ban threshold in percent (0-100).
DEFAULT_THRESHOLD=40
# Default policy preset: nsfw_only | nsfw_and_contact | nsfw_or_keywords | strict
DEFAULT_POLICY=nsfw_and_contact
# Default action: ban | delete | mute | warn | report
DEFAULT_ACTION=ban
# How many of the newest profile photos to scan (index 0 is the pinned /
# currently displayed one). 2 covers "current + previous".
PROFILE_PHOTOS_TO_SCAN=2
# New groups start in dry-run (detect & report, never punish). Strongly
# recommended for the first week of any group.
DEFAULT_DRY_RUN=false
# Only scan members who joined recently or whose message count is below this.
# 0 disables the grace window and scans everyone.
DEFAULT_GRACE_MESSAGES=5
# Bot's own group messages are KEPT by default (they advertise the bot).
DEFAULT_AUTO_DELETE_BOT_MESSAGES=false
DEFAULT_BOT_MESSAGE_TTL_SECS=60

# ---- Group media scan (per-group values override these) ------------------
# Scans the photos, GIFs, stickers and videos posted in a group — every
# member's, not just newcomers' — as opposed to the profile behind them.
# Off by default: it downloads and scores every picture posted, which is a
# decision an admin should make rather than inherit. Admins turn it on under
# /nsfw → Media scan.
DEFAULT_MEDIA_SCAN=false
# Confidence needed to act on a posted image, in percent. Far above
# DEFAULT_THRESHOLD on purpose: a profile is judged on several signals at once,
# but a picture stands alone, so near-certainty is the right bar.
DEFAULT_MEDIA_THRESHOLD=90
# What to do about explicit media: ban | delete | mute | warn | report. Deleting
# the picture is proportionate; banning a long-standing member over one post is
# a bigger call, so that stays opt-in.
DEFAULT_MEDIA_ACTION=delete
# Stills sampled across each GIF or video. 1 means trusting Telegram's preview
# frame, which is exactly the blind spot this exists to close.
DEFAULT_MEDIA_FRAMES=5
# Ban bots that were added to a group without being made administrators.
# Advertising bots carry no NSFW signal at all — logo avatar, empty bio, plain
# text — so no threshold catches them; what gives them away is that nobody
# promoted them. Off by default: a group running its own unpromoted helper bot
# should not inherit a rule that removes it. Admins turn it on under
# /nsfw -> Ban unpromoted bots.
DEFAULT_BAN_FOREIGN_BOTS=false

# ---- Message text scan (per-group values override these) -----------------
# Judges what people write rather than what they look like. Needs JEV_API_KEY;
# with none set these do nothing at all. Off by default: reading every member's
# messages is a decision an admin makes under /nsfw -> Text scan, not one a
# group inherits. New groups start watching only `sexual` — every other subject
# is a moderation opinion the group has to state for itself.
DEFAULT_TEXT_SCAN=false
# How strongly a message must be ABOUT a watched subject before acting, in
# percent. The rubric's midpoint is "touches on it in passing", so 70+ keeps
# ordinary conversation out of it.
DEFAULT_TEXT_THRESHOLD=70
# ban | delete | mute | warn | report
DEFAULT_TEXT_ACTION=delete

# ---- Advertising guard (per-group values override these) -----------------
# A different question from the topics above: a topic asks what a message is
# about, this asks what it is for.
DEFAULT_AD_SCAN=false
DEFAULT_AD_THRESHOLD=75
# `warn` by default and deliberately: most people who drop a link in a group
# are members, not spammers, and deleting their message without a word reads as
# the bot malfunctioning.
DEFAULT_AD_ACTION=warn

# ---- Reaction scan (per-group values override these) ---------------------
# Scan the accounts that react to messages, not just the ones that write them.
# A reaction puts a spam profile in front of the group with nothing of its own
# to delete, which is exactly why the rings use it. Needs no Jev key — it
# reuses the profile scan. The message under a reaction belongs to somebody
# innocent and is never deleted or replied to.
# Telegram only delivers reaction updates to a bot that is an administrator.
DEFAULT_REACTION_SCAN=false

# Number of independent groups that must ban a user before the global
# reputation filter flags them elsewhere.
GLOBAL_REPUTATION_MIN_BANS=3

# ---- Caching / limits ----------------------------------------------------
SCAN_CACHE_TTL_SECS=86400
ADMIN_CACHE_TTL_SECS=300
# Private-chat NSFW test: max images per user per minute.
TEST_MODE_RATE_PER_MIN=10
# Broadcast send rate (messages/second). Telegram tolerates ~30/s bot-wide.
BROADCAST_RATE_PER_SEC=25

# ---- Logging -------------------------------------------------------------
RUST_LOG=info,zeronsfw_bot=debug,teloxide=warn,sqlx=warn
